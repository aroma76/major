  <mxGeometry x="1040" y="520" width="360" height="80" as="geometry"/>
</mxCell>
<mxCell id="sk-room-note" value="Room Architecture:&#xa;&#xa;• Each user auto-joins user_{id} on connect&#xa;• Channel rooms joined via 'channel:join'&#xa;• A user can be in multiple rooms&#xa;• Rooms are isolated — no cross-channel leakage" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
  <mxGeometry x="1040" y="640" width="360" height="140" as="geometry"/>
</mxCell>


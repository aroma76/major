<mxCell id="err-rate" value="⊗ 429 Too Many Requests" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="200" height="44" as="geometry"/></mxCell>
<mxCell id="err-jwt" value="⊗ 401 Unauthorized" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="400" width="200" height="44" as="geometry"/></mxCell>

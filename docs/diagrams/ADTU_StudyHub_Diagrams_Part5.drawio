<mxCell id="as7" value="⑦  200 OK  { token, user }" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="930" width="380" height="54" as="geometry"/></mxCell>

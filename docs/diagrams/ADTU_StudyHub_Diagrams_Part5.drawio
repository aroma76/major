  <mxGeometry x="480" y="280" width="460" height="90" as="geometry"/>
</mxCell>
<mxCell id="sk-msend" value="on('message:send', data)&#xa;1.  INSERT INTO messages (PostgreSQL)&#xa;2.  Fetch message with sender join&#xa;3.  io.to('channel_{id}').emit('message:new', msg)" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
  <mxGeometry x="480" y="410" width="460" height="110" as="geometry"/>
</mxCell>
<mxCell id="sk-notif-svr" value="Triggered from REST Controllers:&#xa;_io.to('user_{userId}').emit(&#xa;  'notification:new', notification)&#xa;→  INSERT INTO notifications (PostgreSQL)" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
  <mxGeometry x="480" y="560" width="460" height="110" as="geometry"/>
</mxCell>
<mxCell id="sk-dc" value="on('disconnect')&#xa;→  Cleanup, logging" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
  <mxGeometry x="480" y="710" width="460" height="70" as="geometry"/>
</mxCell>

<!-- PostgreSQL (bottom center) -->
<mxCell id="sk-pgdb" value="PostgreSQL (Neon)&#xa;messages · notifications" style="shape=cylinder3;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="540" y="860" width="300" height="120" as="geometry"/></mxCell>

<!-- ── ROOMS ── -->

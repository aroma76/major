<mxCell id="r1e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=2;" edge="1" source="rl4" target="rl5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r1e5" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=2;" edge="1" source="rl5" target="rl6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

<!-- Row 2: Server Processing (right to left) -->
<mxCell id="rl-hdr2" value="← SERVER PROCESSING" style="text;strokeColor=none;fillColor=#d5e8d4;fontSize=13;fontStyle=1;align=center;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1500" height="36" as="geometry"/></mxCell>

<mxCell id="rl7" value="⑦ protect()&#xa;Middleware&#xa;&#xa;jwt.verify(token)&#xa;→ req.user = payload&#xa;→ 401 if invalid/expired" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="420" width="200" height="140" as="geometry"/></mxCell>
<mxCell id="rl8" value="⑧ authorize()&#xa;Middleware&#xa;&#xa;Check req.user.role&#xa;vs route's roles[]&#xa;→ 403 if denied" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="200" height="140" as="geometry"/></mxCell>
<mxCell id="rl9" value="⑨ Controller&#xa;Function&#xa;&#xa;Business logic&#xa;Input validation&#xa;Build SQL query" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="200" height="140" as="geometry"/></mxCell>
<mxCell id="rl10" value="⑩ PostgreSQL&#xa;&#xa;pool.query(sql, params)&#xa;Parameterized query&#xa;Returns rows []" style="shape=cylinder3;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="420" width="200" height="140" as="geometry"/></mxCell>
<mxCell id="rl11" value="⑪ Build Response&#xa;&#xa;{ success: true,&#xa;  data: [...] }&#xa;or { error: '...' }" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="420" width="200" height="140" as="geometry"/></mxCell>
<mxCell id="rl12" value="⑫ Riverpod&#xa;State Update&#xa;&#xa;state = AsyncData(data)&#xa;Widget rebuilds" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="200" height="140" as="geometry"/></mxCell>


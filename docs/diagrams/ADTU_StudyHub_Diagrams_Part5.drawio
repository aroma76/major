<mxCell id="as11" value="⑪  SocketService.connect(jwt)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="1230" width="280" height="54" as="geometry"/></mxCell>

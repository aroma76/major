<mxCell id="rl-sup" value="⑩b  Supabase Storage (optional)&#xa;Multer → stream → publicUrl" style="shape=cylinder3;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="660" width="280" height="100" as="geometry"/></mxCell>

<!-- Events panel -->
<mxCell id="sk-emit" value="Events: Client → Server&#xa;&#xa;emit('channel:join', {channelId})&#xa;emit('message:send', {channelId, content})&#xa;disconnect" style="rounded=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">

  <mxGeometry x="300" y="20" width="1000" height="44" as="geometry"/>
</mxCell>

<!-- Row 1: Request Phase (left to right) -->
<mxCell id="rl-hdr1" value="REQUEST PHASE  →" style="text;strokeColor=none;fillColor=#dae8fc;fontSize=13;fontStyle=1;align=center;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="1500" height="36" as="geometry"/></mxCell>

<mxCell id="rl1" value="① Flutter Widget&#xa;&#xa;Provider calls&#xa;ApiService.dio.get()" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="180" height="120" as="geometry"/></mxCell>
<mxCell id="rl2" value="② Dio Interceptor&#xa;&#xa;Attach:&#xa;Authorization: Bearer &lt;JWT&gt;&#xa;Content-Type: application/json" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="150" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="rl3" value="③ HTTPS Request&#xa;&#xa;TLS 1.3 encrypted&#xa;→ Render.com endpoint&#xa;api.adtu.app/api/..." style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="rl4" value="④ CORS Check&#xa;&#xa;Origin whitelist:&#xa;Vercel domain ✓&#xa;Unknown origin ✗" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="rl5" value="⑤ Rate Limiter&#xa;&#xa;Global: 200/15 min&#xa;Login: 10/15 min&#xa;429 if exceeded" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="rl6" value="⑥ Express Router&#xa;&#xa;Match route:&#xa;POST /api/channels&#xa;GET /api/messages/:id" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="200" height="120" as="geometry"/></mxCell>

<!-- Row 1 arrows -->
<mxCell id="r1e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=2;" edge="1" source="rl1" target="rl2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r1e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeWidth=2;" edge="1" source="rl2" target="rl3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

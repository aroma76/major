# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000

# ─── Database (Neon PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=<your-strong-secret-key>
JWT_EXPIRES_IN=7d

# ─── Frontend URL (for CORS) ──────────────────────────────────
CLIENT_URL=http://localhost:9090

# ─── File Storage ─────────────────────────────────────────────
# Options:
#   supabase  → upload files to Supabase Storage (default)
#   local     → save files to backend/uploads/ on disk
#               Use this if Supabase is paused, deleted, or unavailable.
STORAGE_PROVIDER=supabase

# ─── Supabase (only needed when STORAGE_PROVIDER=supabase) ────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key>
SUPABASE_ANON_KEY=<your-anon-key>
